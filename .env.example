# =====================================================================
#  Ukrainian RAG — environment example. Copy to `.env` and adjust.
#  Hostnames below match the docker-compose services in deploy/.
# =====================================================================

# --- App -------------------------------------------------------------
APP_NAME="Ukrainian RAG"
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# --- Vector store (the only persistence layer) -----------------------
# One of: qdrant | pgvector | weaviate (start the matching compose profile)
VECTOR_STORE=qdrant

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# pgvector: schema is created by Alembic (`alembic upgrade head`)
PGVECTOR_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# --- Embeddings (vLLM, OpenAI-compatible /v1/embeddings) -------------
EMBEDDING_BASE_URL=http://vllm-embed:8000/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Matryoshka truncation. Must be <= 2000 for pgvector HNSW; must match the
# dimension used when the pgvector migration was run.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# --- Reranker (cross-encoder, vLLM /rerank) --------------------------
RERANKER_BASE_URL=http://vllm-rerank:8000
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# --- LLM -------------------------------------------------------------
# auto = first provider with a key (anthropic -> openai -> gemini -> openrouter -> groq), else self-hosted vLLM
# One of: auto | anthropic | openai | gemini | openrouter | groq | vllm | ollama
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# GroqCloud (OpenAI-compatible, very fast inference)
GROQ_CLOUD_API=
GROQ_MODEL=qwen/qwen3.8-27b
# alternatives on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b

# Self-hosted Qwen LLM on vLLM (docker compose profile `vllm-llm`)
VLLM_LLM_BASE_URL=http://vllm-llm:8000/v1
VLLM_LLM_MODEL=Qwen/Qwen3-8B-AWQ

# Ollama server (e.g. running on the Docker host)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b

# --- Retrieval -------------------------------------------------------
RETRIEVAL_TOP_K=3
RERANK_TOP_N=1
RRF_K=60
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0

# --- Chunking / uploads ----------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
# URL ingestion SSRF protection: keep false
ALLOW_PRIVATE_URLS=false

# --- Safety ----------------------------------------------------------
MAX_QUESTION_CHARS=4000
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_CHARS_PER_CHUNK=4000

# --- vLLM / Hugging Face (deploy) ------------------------------------
HF_TOKEN=

# --- Streamlit UI ----------------------------------------------------
API_URL=http://api:8000/api/v1
